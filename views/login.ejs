<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SAFFE - Inicio de Sesión</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/css/index.css">
    <script>window.SAFFE_API_URL = "<%= apiUrl %>";</script>

</head>

<body>

<header>

    <img src="/img/logo.png" alt="Logo SAFFE" width="100">

    <h1>SAFFE</h1>

    <h2>Sistema de Control de Acceso Ejército Nacional</h2>

</header>

<main>

    <section aria-labelledby="login-title">

        <h3 id="login-title">Iniciar sesión</h3>

       <form id="loginForm">

            <label for="documento">Documento</label>

            <div class="input-icon input-icon--documento">
                <input
                    id="documento"
                    type="text"
                    name="documento"
                    placeholder="Ingrese su documento"
                    autocomplete="username"
                    required
                >
            </div>

            <label for="password">Contraseña</label>

            <div class="input-icon input-icon--password">
                <input
                    id="password"
                    type="password"
                    name="contraseña"
                    placeholder="Ingrese su clave"
                    autocomplete="current-password"
                    required
                >
            </div>

            <a href="#">¿Olvidaste la contraseña?</a>

            <button type="submit">

                Ingresar

            </button>

        </form>

    </section>

    <aside class="mascota-ayudante" aria-label="Mascota de SAFFE">
        <span class="mascota-saludo">¡Hola! Estoy aquí para ayudarte</span>
        <img src="/img/mascota.png" alt="Mascota de SAFFE saludando">
    </aside>

    <button
        class="btn-biometrico"
        onclick="window.location='/escaneo'">

        Ingresar con reconocimiento facial

    </button>

</main>

<footer>

    <p>© 2025 SAFFE - Sistema de Control de Acceso</p>

</footer>

<!-- JavaScript -->
<script src="/config.js"></script>
<script type="module" src="/js/main.js"></script>

</body>

</html>